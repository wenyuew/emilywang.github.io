{
  "manifest_version": 3,
  "name": "Quocci Cucci",
  "version": "1.2.0",
  "description": "The best quotes from any YouTube video, with timestamps. Click a quote to jump there, or ask questions about the video.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "Quocci Cucci",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
